---
import Layout from "../layouts/Layout.astro";

const projects = [
  {
    name: "Rune (Runestone Safari)",
    description:
      "Interactive runestone map with 6,815+ runestones, search, and offline caching.",
    url: "https://github.com/norrdev/rune",
    tags: ["Interactive Map", "Offline Caching", "Expo", "React Native"]
  },
  {
    name: "OpenGym",
    description:
      "Cross-platform workout journal and private digital trainer with no tracking.",
    url: "https://github.com/norrdev/OpenGym",
    tags: ["Cross-platform", "Privacy-first", "Fitness Tracker", "SQLite"]
  }
];
---

<Layout>
  <header class="hero animate-fade-in-up">
    <div class="logo-container">
      <img src="/images/logo-full.png" alt="NorrDev logo" class="logo" />
    </div>
    <p class="tagline">Crafting side-projects, utility tools, and open-source solutions.</p>
  </header>

  <section class="section animate-fade-in-up delay-1">
    <h1>Portfolio & Side Projects</h1>
    <p class="section-text">
      norr.dev is an independent personal lab for building useful products, sharing the engineering journey,
      and shipping production-ready code often.
    </p>
  </section>

  <section class="section animate-fade-in-up delay-2">
    <h2>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 0.25rem;"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
      Featured Projects
    </h2>
    <div class="grid">
      {
        projects.map((project) => (
          <article class="card">
            <div class="card-content">
              <h3>{project.name}</h3>
              <p>{project.description}</p>
              <div class="badge-container">
                {project.tags.map((tag, idx) => (
                  <span class={idx % 2 === 0 ? "badge badge-primary" : "badge badge-secondary"}>{tag}</span>
                ))}
              </div>
            </div>
            <div class="card-action">
              <a class="button-link button-primary" href={project.url} target="_blank" rel="noreferrer">
                <span>View on GitHub</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <footer class="footer animate-fade-in-up delay-3">
    <a class="button-link" href="https://github.com/norrdev" target="_blank" rel="noreferrer">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
      <span>GitHub</span>
    </a>
    <a class="button-link" href="mailto:mail@norr.dev">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
      <span>mail@norr.dev</span>
    </a>
  </footer>
</Layout>
