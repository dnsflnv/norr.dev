---
import Layout from "../layouts/Layout.astro";

const projects = [
  {
    name: "Rune (Runestone Safari)",
    description:
      "Interactive runestone map with 6,815+ runestones, search, and offline caching.",
    url: "https://github.com/norrdev/rune"
  },
  {
    name: "OpenGym",
    description:
      "Cross-platform workout journal and private digital trainer with no tracking.",
    url: "https://github.com/norrdev/OpenGym"
  }
];
---

<Layout>
  <header class="hero">
    <img src="/images/logo-full.png" alt="NorrDev logo" class="logo" />
    <p class="tagline">Crafting side-projects and open-source solutions.</p>
  </header>

  <section class="section">
    <h1>Portfolio & Side Projects</h1>
    <p>
      norr.dev is a personal lab for building useful products, sharing what works,
      and shipping often.
    </p>
  </section>

  <section class="section">
    <h2>Projects</h2>
    <div class="grid">
      {
        projects.map((project) => (
          <article class="card">
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            <a class="button-link" href={project.url} target="_blank" rel="noreferrer">
              View on GitHub
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <footer class="footer">
    <a class="button-link" href="https://github.com/norrdev" target="_blank" rel="noreferrer">GitHub</a>
    <a class="button-link" href="mailto:mail@norr.dev">mail@norr.dev</a>
  </footer>
</Layout>
